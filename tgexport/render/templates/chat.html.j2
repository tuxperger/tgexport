{% extends "base.html.j2" %}
{% block title %}{{ chat.title }} — Telegram Archive{% endblock %}
{% block nav %}<a href="../index.html">← All chats</a>{% endblock %}
{% block content %}
<h1>{{ chat.title }} <span class="type-badge">{{ chat.type }}</span></h1>

<div class="search-box">
  <input id="search-input" type="search" placeholder="Search in this chat…" autocomplete="off">
</div>
<div id="search-results" class="search-results" hidden></div>

{% for msg in messages %}
<div class="msg" id="msg-{{ msg.id }}">
  {% if msg.service_type %}
    <div class="msg-service">— {{ msg.service_type }}{% if msg.text %}: {{ msg.text }}{% endif %} —</div>
  {% elif msg.is_deleted and not msg.text %}
    <div class="msg-deleted">[message deleted]</div>
  {% else %}
    <div class="msg-header">
      <span class="msg-sender">{{ msg.sender_name or "Unknown" }}</span>
      <span class="msg-date">{{ msg.date | format_datetime }}</span>
      {% if msg.edits %}<span class="edited-marker">✎ edited</span>{% endif %}
      {% if msg.is_deleted %}<span class="msg-deleted">[deleted]</span>{% endif %}
    </div>

    {% if msg.fwd_from_name %}
    <div class="fwd-from">↪ forwarded from {{ msg.fwd_from_name }}</div>
    {% endif %}

    {% if msg.reply_to_msg_id %}
    <div class="reply-quote">
      {% set quoted = reply_map.get(msg.reply_to_msg_id) %}
      {% if quoted %}
        <span class="reply-sender">{{ quoted.sender_name or "Unknown" }}</span><br>
        <a href="#msg-{{ quoted.id }}">{{ quoted.text | truncate_text }}</a>
      {% else %}
        <span class="missing">(message unavailable)</span>
      {% endif %}
    </div>
    {% endif %}

    {% if msg.text %}<div class="msg-text">{{ msg.text }}</div>{% endif %}

    {% for att in msg.attachments %}
    <div class="media">
      {% if att.local_path %}
        {% set src = media_prefix ~ att.local_path %}
        {% if att.category == "photo" or att.category == "sticker" %}
          <a href="{{ src }}"><img src="{{ src }}" alt="{{ att.category }}" loading="lazy"></a>
        {% elif att.category == "video" %}
          <video controls preload="metadata" src="{{ src }}"></video>
        {% elif att.category == "gif" %}
          <video autoplay loop muted playsinline src="{{ src }}"></video>
        {% elif att.category == "video_note" %}
          <video class="video-note" controls preload="metadata" src="{{ src }}"></video>
        {% elif att.category == "voice" or att.category == "audio" %}
          <audio controls preload="none" src="{{ src }}"></audio>
        {% else %}
          <a class="doc-link" href="{{ src }}">{{ att.category | media_icon }} {{ att.local_path.rsplit("/", 1)[-1] }}</a>
        {% endif %}
      {% else %}
        <span class="missing">{{ att.category | media_icon }} {{ att.category }} (not downloaded)</span>
      {% endif %}
    </div>
    {% endfor %}

    {% if msg.reactions %}
    <div class="reactions">
      {% for r in msg.reactions %}<span>{{ r.emoji }} {{ r.count }}</span>{% endfor %}
    </div>
    {% endif %}

    {% if msg.edits | length > 0 %}
    <details class="edit-history">
      <summary>edit history</summary>
      <ul>
      {% for e in msg.edits %}
        <li>{{ e.edited_at | format_datetime }}: {{ e.text | truncate_text }}</li>
      {% endfor %}
      </ul>
    </details>
    {% endif %}
  {% endif %}
</div>
{% endfor %}

<div class="pagination">
  {% if page > 1 %}<a href="page_{{ "%03d" | format(page - 1) }}.html">← prev</a>{% endif %}
  <span>page {{ page }} of {{ total_pages }}</span>
  {% if page < total_pages %}<a href="page_{{ "%03d" | format(page + 1) }}.html">next →</a>{% endif %}
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
  "use strict";
  var input = document.getElementById("search-input");
  var box = document.getElementById("search-results");
  var data = null, requested = false;

  window.TG_SEARCH_REGISTER = function (d) { data = d; run(); };

  function load() {
    if (requested) return;
    requested = true;
    var s = document.createElement("script");
    s.src = "search.js";
    s.onerror = function () { box.hidden = false; box.textContent = "search.js not found — re-run `tgexport render`"; };
    document.head.appendChild(s);
  }

  function run() {
    var q = input.value.trim().toLowerCase();
    if (!q) { box.hidden = true; box.innerHTML = ""; return; }
    if (!data) { load(); box.hidden = false; box.textContent = "Loading search index…"; return; }
    var words = q.split(/\s+/);
    var hits = [];
    for (var i = 0; i < data.messages.length && hits.length < 200; i++) {
      var m = data.messages[i]; // [id, page, sender, date, text]
      var hay = (m[2] + "\n" + m[4]).toLowerCase();
      var ok = true;
      for (var w = 0; w < words.length; w++) if (hay.indexOf(words[w]) === -1) { ok = false; break; }
      if (ok) hits.push(m);
    }
    render(hits);
  }

  function render(hits) {
    box.hidden = false;
    box.innerHTML = "";
    var head = document.createElement("div");
    head.className = "search-count";
    head.textContent = hits.length
      ? hits.length + " result(s)" + (hits.length >= 200 ? ", showing first 200" : "")
      : "No results";
    box.appendChild(head);
    hits.forEach(function (m) {
      var a = document.createElement("a");
      a.className = "search-result";
      a.href = "page_" + String(m[1]).padStart(3, "0") + ".html#msg-" + m[0];
      var meta = document.createElement("div");
      meta.className = "sr-meta";
      meta.textContent = (m[2] || "Unknown") + " · " + m[3].slice(0, 10);
      var body = document.createElement("div");
      body.textContent = m[4].length > 200 ? m[4].slice(0, 200) + "…" : m[4];
      a.appendChild(meta);
      a.appendChild(body);
      box.appendChild(a);
    });
  }

  input.addEventListener("input", run);
  input.addEventListener("focus", load);
})();
</script>
{% endblock %}
