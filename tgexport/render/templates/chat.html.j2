{% extends "base.html.j2" %}
{% block title %}{{ chat.title }} — Telegram Archive{% endblock %}
{% block nav %}<a href="../index.html">← All chats</a>{% endblock %}
{% block content %}
<h1>{{ chat.title }} <span class="type-badge">{{ chat.type }}</span></h1>

{% for msg in messages %}
<div class="msg" id="msg-{{ msg.id }}">
  {% if msg.service_type %}
    <div class="msg-service">— {{ msg.service_type }}{% if msg.text %}: {{ msg.text }}{% endif %} —</div>
  {% elif msg.is_deleted and not msg.text %}
    <div class="msg-deleted">[message deleted]</div>
  {% else %}
    <div class="msg-header">
      <span class="msg-sender">{{ msg.sender_name or "Unknown" }}</span>
      <span class="msg-date">{{ msg.date | format_datetime }}</span>
      {% if msg.edits %}<span class="edited-marker">✎ edited</span>{% endif %}
      {% if msg.is_deleted %}<span class="msg-deleted">[deleted]</span>{% endif %}
    </div>

    {% if msg.fwd_from_name %}
    <div class="fwd-from">↪ forwarded from {{ msg.fwd_from_name }}</div>
    {% endif %}

    {% if msg.reply_to_msg_id %}
    <div class="reply-quote">
      {% set quoted = reply_map.get(msg.reply_to_msg_id) %}
      {% if quoted %}
        <span class="reply-sender">{{ quoted.sender_name or "Unknown" }}</span><br>
        <a href="#msg-{{ quoted.id }}">{{ quoted.text | truncate_text }}</a>
      {% else %}
        <span class="missing">(message unavailable)</span>
      {% endif %}
    </div>
    {% endif %}

    {% if msg.text %}<div class="msg-text">{{ msg.text }}</div>{% endif %}

    {% for att in msg.attachments %}
    <div class="media">
      {% if att.local_path %}
        {% set src = media_prefix ~ att.local_path %}
        {% if att.category == "photo" or att.category == "sticker" %}
          <a href="{{ src }}"><img src="{{ src }}" alt="{{ att.category }}" loading="lazy"></a>
        {% elif att.category == "video" %}
          <video controls preload="metadata" src="{{ src }}"></video>
        {% elif att.category == "gif" %}
          <video autoplay loop muted playsinline src="{{ src }}"></video>
        {% elif att.category == "video_note" %}
          <video class="video-note" controls preload="metadata" src="{{ src }}"></video>
        {% elif att.category == "voice" or att.category == "audio" %}
          <audio controls preload="none" src="{{ src }}"></audio>
        {% else %}
          <a class="doc-link" href="{{ src }}">{{ att.category | media_icon }} {{ att.local_path.rsplit("/", 1)[-1] }}</a>
        {% endif %}
      {% else %}
        <span class="missing">{{ att.category | media_icon }} {{ att.category }} (not downloaded)</span>
      {% endif %}
    </div>
    {% endfor %}

    {% if msg.reactions %}
    <div class="reactions">
      {% for r in msg.reactions %}<span>{{ r.emoji }} {{ r.count }}</span>{% endfor %}
    </div>
    {% endif %}

    {% if msg.edits | length > 0 %}
    <details class="edit-history">
      <summary>edit history</summary>
      <ul>
      {% for e in msg.edits %}
        <li>{{ e.edited_at | format_datetime }}: {{ e.text | truncate_text }}</li>
      {% endfor %}
      </ul>
    </details>
    {% endif %}
  {% endif %}
</div>
{% endfor %}

<div class="pagination">
  {% if page > 1 %}<a href="page_{{ "%03d" | format(page - 1) }}.html">← prev</a>{% endif %}
  <span>page {{ page }} of {{ total_pages }}</span>
  {% if page < total_pages %}<a href="page_{{ "%03d" | format(page + 1) }}.html">next →</a>{% endif %}
</div>
{% endblock %}
