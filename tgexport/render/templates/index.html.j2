{% extends "base.html.j2" %}
{% block title %}Telegram Archive{% endblock %}
{% block nav %}{% endblock %}
{% block content %}
<h1>Telegram Archive</h1>

<div id="status" class="status" hidden>Browsers block loading data over file:// — open the archive via <code>tgexport serve</code>.</div>

<div class="search-box">
  <input id="search-input" type="search" placeholder="Search across all chats…" autocomplete="off">
</div>
<div id="search-results" class="search-results" hidden></div>

<ul class="chat-list">
{% for entry in chats %}
  <li>
    <a href="{{ entry.chat.id }}/index.html">{{ entry.chat.title }}</a>
    <span class="type-badge">{{ entry.chat.type }}</span>
    <div class="chat-meta">
      {% if entry.message_count == 0 %}(empty){% else %}{{ entry.message_count }} messages{% endif %}
      {% if entry.last_date %} · last: {{ entry.last_date | format_datetime }}{% endif %}
    </div>
  </li>
{% endfor %}
</ul>
{% endblock %}
{% block scripts %}
<script>
(function () {
  "use strict";
  if (location.protocol === "file:") document.getElementById("status").hidden = false;

  var input = document.getElementById("search-input");
  var box = document.getElementById("search-results");
  var chats = null;          // [{id, title}] from chats.json
  var indexes = {};          // chat id -> [id, chunk, sender, date, text][]
  var loadedCount = 0, requested = false;

  function fetchJSON(url) {
    return fetch(url).then(function (r) {
      if (!r.ok) throw new Error(url + ": HTTP " + r.status);
      return r.json();
    });
  }

  function load() {
    if (requested) return;
    requested = true;
    fetchJSON("chats.json").then(function (list) {
      chats = list;
      chats.forEach(function (c) {
        fetchJSON(c.id + "/data/search.json")
          .then(function (d) { indexes[c.id] = { chat: c, messages: d }; })
          .catch(function () {})
          .then(function () { loadedCount++; run(); });
      });
      run();
    }).catch(function (err) {
      box.hidden = false;
      box.textContent = "chats.json unavailable (" + err.message + ") — re-run `tgexport render` and open via `tgexport serve`";
    });
  }

  function run() {
    var q = input.value.trim().toLowerCase();
    if (!q) { box.hidden = true; box.innerHTML = ""; return; }
    load();
    box.hidden = false;
    var pending = chats === null || loadedCount < chats.length;
    var words = q.split(/\s+/);
    var hits = [];
    outer:
    for (var id in indexes) {
      var d = indexes[id];
      for (var i = 0; i < d.messages.length; i++) {
        var m = d.messages[i]; // [id, chunk, sender, date, text]
        var hay = (m[2] + "\n" + m[4]).toLowerCase();
        var ok = true;
        for (var w = 0; w < words.length; w++) if (hay.indexOf(words[w]) === -1) { ok = false; break; }
        if (ok) {
          hits.push({ chat: d.chat, m: m });
          if (hits.length >= 300) break outer;
        }
      }
    }
    render(hits, pending);
  }

  function render(hits, pending) {
    box.innerHTML = "";
    var head = document.createElement("div");
    head.className = "search-count";
    head.textContent =
      (hits.length ? hits.length + " result(s)" + (hits.length >= 300 ? ", showing first 300" : "") : "No results") +
      (pending ? " — loading indexes (" + loadedCount + "/" + (chats ? chats.length : "?") + ")…" : "");
    box.appendChild(head);
    hits.forEach(function (h) {
      var a = document.createElement("a");
      a.className = "search-result";
      a.href = h.chat.id + "/index.html#msg-" + h.m[0];
      var meta = document.createElement("div");
      meta.className = "sr-meta";
      var chatSpan = document.createElement("span");
      chatSpan.className = "sr-chat";
      chatSpan.textContent = h.chat.title;
      meta.appendChild(chatSpan);
      meta.appendChild(document.createTextNode(" · " + (h.m[2] || "Unknown") + " · " + h.m[3].slice(0, 10)));
      var body = document.createElement("div");
      body.textContent = h.m[4].length > 200 ? h.m[4].slice(0, 200) + "…" : h.m[4];
      a.appendChild(meta);
      a.appendChild(body);
      box.appendChild(a);
    });
  }

  input.addEventListener("input", run);
  input.addEventListener("focus", load);
})();
</script>
{% endblock %}
