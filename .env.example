# tgexport configuration template.
# Copy to .env, fill in values, then restrict access:
#   cp .env.example .env && chmod 600 .env

# Required: obtain from https://my.telegram.org/apps
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef

# Alternative if my.telegram.org does not work for you: import the session from
# an installed Telegram Desktop (requires `pip install 'tgexport[tdata]'`):
#   tgexport login --tdata ~/.local/share/TelegramDesktop/tdata
# then set the line below instead of TG_API_ID/TG_API_HASH:
#TG_API_CREDENTIALS=desktop

# Optional: proxy for reaching Telegram if direct MTProto connections are
# blocked on your network. Supported schemes:
#   socks5://[user:pass@]host:port   socks4://host:port   http://host:port
#   mtproxy://SECRET@host:port       (Telegram MTProto proxy)
#TG_PROXY=socks5://127.0.0.1:1080

# Optional: which chats to save (see `tgexport chats` for names and IDs).
# Comma-separated chat IDs or exact titles; blacklist wins over whitelist.
# CLI flags --include/--exclude/--type override these.
#TG_INCLUDE_CHATS=123456789,-1001234567890,Saved Messages
#TG_EXCLUDE_CHATS=-1009876543210
# Restrict to types: private, group, supergroup, channel
#TG_CHAT_TYPES=private,supergroup

# Optional (defaults shown)
TG_SESSION_PATH=data/session.session
TG_DB_PATH=data/archive.db
TG_MEDIA_DIR=data/media
TG_OUTPUT_DIR=output
TG_LOG_LEVEL=INFO
